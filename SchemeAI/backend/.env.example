# ============================================================================
# SchemeAI Backend Environment Variables (.env)
# ============================================================================

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Keep the Service Role Key strictly on the backend! NEVER share in frontend code!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase JWT Secret for direct offline cryptographic validation
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS Configuration: comma-separated list of allowed frontend origins
# Add your local Live Server, Vite, or Python http.server ports
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Future Phase AI Chatbot (Google Gemini API — strictly called from Python backend)
GEMINI_API_KEY=your-gemini-api-key-here
